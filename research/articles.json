---
layout: null
---

[  {% assign articles_folders = site.html_pages | where_exp: "item", "item.path contains 'research/articles/ArticleNo'" %}
  {% assign sorted_articles = articles_folders | sort: "path" | reverse %}
  {% for article in sorted_articles %}
    {% if article.path contains "post.md" %}      {% assign folder_name = article.path | split: "/" | slice: -2, 1 | first %}
      {% assign article_number = folder_name | remove: "ArticleNo" %}
      {
        "id": "{{ article_number }}",
        "title": "{{ article.title | escape }}",
        "description": "{{ article.description | escape }}",
        "date": "{{ article.date | date_to_xmlschema }}",
        "summary": "{{ article.content | strip_html | truncatewords: 50 | escape }}",
        "url": "{{ article.url | relative_url }}",
        "author": "{{ article.author | escape }}",
        "profile_picture": "{{ article.profile_picture | escape }}",
        {% assign article_folder = '/research/articles/ArticleNo' | append: article_number %}
        {% assign thumb_url = '' %}
        {% if article.image %}
          {% assign image_first = article.image | slice: 0,1 %}
          {% if article.image contains '://' %}
            {% assign thumb_url = article.image %}
          {% elsif image_first == '/' %}
            {% assign thumb_url = article.image %}
          {% else %}
            {% assign thumb_url = article_folder | append: '/' | append: article.image %}
          {% endif %}
        {% else %}
          {% assign thumb_exts = 'svg,png,jpg,jpeg,gif,webp' | split: ',' %}
          {% for ext in thumb_exts %}
            {% assign candidate = article_folder | append: '/thumbnail.' | append: ext %}
            {% assign matched = site.static_files | where_exp: 'f', 'f.path == candidate' %}
            {% if matched.size > 0 %}{% assign thumb_url = candidate %}{% break %}{% endif %}
          {% endfor %}
        {% endif %}
        "thumbnail": "{% if thumb_url != '' %}{{ thumb_url | relative_url }}{% endif %}",
        "tags": [
          {% if article.tags %}
            {% for tag in article.tags %}
              "{{ tag }}"{% unless forloop.last %},{% endunless %}
            {% endfor %}
          {% else %}
            "security", "bugbounty"
          {% endif %}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endif %}
  {% endfor %}
]
